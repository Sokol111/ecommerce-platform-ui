# API Configuration
NUXT_TENANT_API_URL=http://localhost:8080

# Logto M2M Authentication
NUXT_LOGTO_URL=http://localhost:3001
NUXT_LOGTO_CLIENT_ID=
NUXT_LOGTO_CLIENT_SECRET=
NUXT_API_RESOURCE_INDICATOR=https://api.sokolshop.com

# OIDC User Authentication (Logto)
NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=
NUXT_OAUTH_OIDC_OPENID_CONFIG_AUTHORIZATION_ENDPOINT=http://localhost:3001/oidc/auth
NUXT_OAUTH_OIDC_OPENID_CONFIG_TOKEN_ENDPOINT=http://logto:3001/oidc/token
NUXT_OAUTH_OIDC_REDIRECT_URL=http://platform.127.0.0.1.nip.io/auth/oidc/callback
NUXT_OIDC_ISSUER=http://localhost:3001/oidc
NUXT_OIDC_JWKS_URL=http://logto:3001/oidc/jwks
NUXT_OIDC_LOGOUT_URL=http://localhost:3001/oidc/session/end
NUXT_OIDC_REVOCATION_URL=http://logto:3001/oidc/token/revocation
NUXT_OIDC_LOGOUT_REDIRECT_URL=http://platform.127.0.0.1.nip.io

# Cookie Settings
NUXT_SESSION_PASSWORD=dev-session-secret-that-is-at-least-48-characters-long
NUXT_SESSION_COOKIE_SECURE=false
NUXT_BASE_DOMAIN=.127.0.0.1.nip.io
