# API Configuration
NUXT_TENANT_API_URL=http://localhost:8080

# Logto M2M Authentication
NUXT_LOGTO_URL=http://localhost:3001
NUXT_LOGTO_CLIENT_ID=
NUXT_LOGTO_CLIENT_SECRET=
NUXT_API_RESOURCE_INDICATOR=https://api.sokolshop.com

# OIDC User Authentication (Logto)
NUXT_OIDC_PROVIDERS_OIDC_CLIENT_ID=
NUXT_OIDC_PROVIDERS_OIDC_CLIENT_SECRET=
NUXT_OIDC_PROVIDERS_OIDC_AUTHORIZATION_URL=http://localhost:3001/oidc/auth
NUXT_OIDC_PROVIDERS_OIDC_TOKEN_URL=http://logto:3001/oidc/token
NUXT_OIDC_PROVIDERS_OIDC_USERINFO_URL=http://logto:3001/oidc/userinfo
NUXT_OIDC_PROVIDERS_OIDC_LOGOUT_URL=http://localhost:3001/oidc/session/end
NUXT_OIDC_PROVIDERS_OIDC_REDIRECT_URI=http://platform.127.0.0.1.nip.io/auth/oidc/callback
NUXT_OIDC_PROVIDERS_OIDC_LOGOUT_REDIRECT_URI=http://platform.127.0.0.1.nip.io

# Cookie Settings
NUXT_COOKIE_SECURE=false
NUXT_BASE_DOMAIN=.127.0.0.1.nip.io
